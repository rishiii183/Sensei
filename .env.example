# Sensei Configuration

# LLM Providers
# If no API key is set, Sensei degrades gracefully to Ollama (free local fallback) or offline heuristic planner.
OPENAI_API_KEY=
DEFAULT_MODEL=openai/gpt-4o-mini
GROQ_API_KEY=
GROQ_MODEL=groq/llama-3.3-70b-versatile
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=ollama/llama3.2

# Operating Mode: COPILOT (default), OBSERVE, AUTOPILOT
SENSEI_MODE=COPILOT

# Cost & Token Budget Controls
PER_SCAN_TOKEN_BUDGET=150000
PER_SCAN_COST_BUDGET=1.50
MAX_TOOL_OUTPUT_CHARS=3000

# Rate Limiting (actions per second)
TOOL_RATE_LIMIT=2.0

# Database
DATABASE_URL=sqlite:///sensei.db

# Docker Isolation
DOCKER_ENABLED=false
